            "en": "Boarding airport (optional)",
            "fr": "Aéroport d’embarquement (facultatif)",
            "de": "Abflughafen (optional)",
            "es": "Aeropuerto de embarque (opcional)"
          },
          "placeholder": {
            "en": "CDG",
            "fr": "CDG",
            "de": "CDG",
            "es": "CDG"
          },
          "description": {
            "en": "For a flight with a stop: the 3-letter code of the airport you board at.",
            "fr": "Pour un vol avec escale : le code à 3 lettres de l’aéroport où vous embarquez.",
            "de": "Bei einem Flug mit Zwischenstopp: der 3-Buchstaben-Code Ihres Abflughafens.",
            "es": "Para un vuelo con escala: el código de 3 letras del aeropuerto donde embarca."
          }
        },
        {
          "key": "destination",
          "type": "string",
          "label": {
            "en": "Arrival airport (optional)",
            "fr": "Aéroport d’arrivée (facultatif)",
            "de": "Zielflughafen (optional)",
            "es": "Aeropuerto de llegada (opcional)"
          },
          "placeholder": {
            "en": "LAX",
            "fr": "LAX",
            "de": "LAX",
            "es": "LAX"
          },
          "description": {
            "en": "For a flight with a stop: the 3-letter code of the airport you leave the plane at.",
