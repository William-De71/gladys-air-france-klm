        },
        {
          "key": "date",
          "type": "string",
          "required": true,
          "label": {
            "en": "Date",
            "fr": "Date",
            "de": "Datum",
            "es": "Fecha"
          },
          "placeholder": {
            "en": "tomorrow",
            "fr": "demain",
            "de": "morgen",
            "es": "mañana"
          },
          "description": {
